{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rodrigoioyz.github.io/credenciales-spec/schemas/openbadges-academic/v1.json",
  "title": "Academic OB v1 extension fragment — design only, not published",
  "description": "Closed academic-only fragment, NOT the full OB subject. Empty is allowed. Full subject unknown fields must be checked separately before extracting this fragment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "academicHours": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "academicProgram": {"$ref": "#/$defs/text"},
    "academicRecognitionLabel": {"$ref": "#/$defs/text"},
    "academicCompetencyCodes": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "maxLength": 2048, "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+(?![\\s\\S])"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f\\u007f\\uD800-\\uDFFF]+(?![\\s\\S])"}
  }
}
